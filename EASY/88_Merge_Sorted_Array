nums1 = [1, 2, 3, 0, 0, 0]
m = 3
nums2 = [2, 5, 6]
n = 3
# [1,2,2,3,5,6]


class Solution:
    def merge(self, nums1: List[int], m: int, nums2: List[int], n: int) -> None:
        """
        Do not return anything, modify nums1 in-place instead.
        """
        o = m + n

        new_list = []
        for i in range(o):
            if i > m - 1:
                nums1[i] = nums2[o - i - 1]
        nums1.sort()


